# Copy to .env. Never commit .env.

# ─── LLM ─────────────────────────────────────────────────────────────────────
# "openai" = gpt-4o-mini, cheap, for development and test runs
# "anthropic" = first-party Claude API; "foundry" = Claude on Microsoft Foundry (Azure). Release configuration.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Foundry only: the resource name of your Microsoft Foundry deployment
FOUNDRY_RESOURCE=

# ─── Retrieval ───────────────────────────────────────────────────────────────
# "local" = BM25 + fastembed on disk; "azure" = Azure AI Search
SEARCH_BACKEND=local
AZURE_SEARCH_ENDPOINT=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_JUDGE_ENDPOINT=
AZURE_JUDGE_DEPLOYMENT=gpt-oss-120b
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=regintel-guidance

# ─── Data ────────────────────────────────────────────────────────────────────
DATA_DIR=data
# Optional: raises openFDA rate limits when refreshing FAERS data
OPENFDA_API_KEY=

# ─── Azure state (empty = in memory) ─────────────────────────────────────────
COSMOS_ENDPOINT=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# API (comma-separated keys; leave empty for open local development)
API_KEYS=
RATE_LIMIT_PER_MINUTE=30
